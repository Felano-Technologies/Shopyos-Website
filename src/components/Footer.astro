---
import icon from '../assets/iconwhite.png';
---
<footer class="bg-navy text-slate-200">
  <div class="mx-auto w-[min(1120px,calc(100%-32px))] py-10 text-sm md:w-[min(1120px,calc(100%-40px))] md:py-14">
    <div class="grid gap-8 md:grid-cols-[1.15fr_.85fr_.85fr_1.05fr] md:gap-12">
      <div class="rounded-3xl bg-white/5 p-5 md:bg-transparent md:p-0">
        <a href="/" aria-label="Shopyos home" class="inline-flex items-center">
          <img src={icon.src} width={icon.width} height={icon.height} alt="Shopyos" class="h-16 w-auto object-contain md:h-24" />
        </a>
        <p class="mt-4 leading-relaxed text-slate-200 md:mt-5">Shopyos is building a local commerce marketplace for buyers and sellers across Ghana.</p>
      </div>
      <div class="grid grid-cols-2 gap-5 md:contents">
        <div>
          <h2 class="text-sm font-extrabold uppercase tracking-[.12em] text-lime md:text-base md:normal-case md:tracking-normal">Marketplace</h2>
          <div class="mt-4 grid gap-3">
            <a class="py-1" href="/buyers">For buyers</a>
            <a class="py-1" href="/sellers">For sellers</a>
            <a class="py-1" href="/drivers">For drivers</a>
            <a class="py-1" href="/features">Features</a>
          </div>
        </div>
        <div>
          <h2 class="text-sm font-extrabold uppercase tracking-[.12em] text-lime md:text-base md:normal-case md:tracking-normal">Company</h2>
          <div class="mt-4 grid gap-3">
            <a class="py-1" href="/about">About</a>
            <a class="py-1" href="/contact">Contact</a>
            <a class="py-1" href="/faq">FAQ</a>
          </div>
        </div>
      </div>
      <div class="rounded-3xl bg-white/5 p-5 md:rounded-none md:bg-transparent md:p-0">
        <h2 class="text-sm font-extrabold uppercase tracking-[.12em] text-lime md:text-base md:normal-case md:tracking-normal">Support</h2>
        <div class="mt-4 grid gap-3">
          <a class="rounded-2xl bg-white/10 px-4 py-3 md:bg-transparent md:px-0 md:py-0" href="tel:+233506514687">Call: +233 50 651 4687</a>
          <a class="rounded-2xl bg-white/10 px-4 py-3 md:bg-transparent md:px-0 md:py-0" href="https://wa.me/233506514687">WhatsApp: +233 50 651 4687</a>
          <a class="rounded-2xl bg-white/10 px-4 py-3 md:bg-transparent md:px-0 md:py-0" href="mailto:support@shopyos.com">support@shopyos.com</a>
          <p class="rounded-2xl border border-white/10 px-4 py-3 text-slate-300 md:border-0 md:px-0 md:py-0">Mon - Fri: 8am - 5pm</p>
        </div>
      </div>
    </div>
  </div>
  <div class="mx-auto grid w-[min(1120px,calc(100%-32px))] gap-6 border-t border-white/10 py-7 text-sm text-slate-300 md:w-[min(1120px,calc(100%-40px))] md:grid-cols-[1fr_1fr] md:gap-8 md:py-8">
    <div>
      <h2 class="text-sm font-extrabold uppercase tracking-[.12em] text-lime md:text-base md:normal-case md:tracking-normal">Office</h2>
      <p class="mt-3 max-w-lg leading-relaxed">Shopyos E-commerce Hub, 18 Nana Kesse Avenue, Ayeduase, near KNUST, Kumasi.</p>
    </div>
    <div>
      <h2 class="text-sm font-extrabold uppercase tracking-[.12em] text-lime md:text-base md:normal-case md:tracking-normal">Legal</h2>
      <div class="mt-3 grid grid-cols-2 gap-3 sm:flex sm:flex-wrap sm:gap-x-5 sm:gap-y-3">
        <a href="/privacy">Privacy policy</a>
        <a href="/delete-account">Delete account</a>
        <a href="/terms">Terms of service</a>
        <a href="/shipping">Shipping policy</a>
        <a href="/returns">Return policy</a>
        <a href="/seller-liability">Seller liability policy</a>
      </div>
    </div>
  </div>
  <div class="mx-auto flex w-[min(1120px,calc(100%-32px))] flex-col gap-4 border-t border-white/10 py-6 text-center text-xs text-slate-400 md:w-[min(1120px,calc(100%-40px))] md:flex-row md:items-center md:justify-between md:text-left">
    <p>© 2026 Shopyos Marketplace. All rights reserved.</p>
    <div class="flex items-center justify-center gap-5 text-slate-300">
      <a href="https://tiktok.com/@shopyos01" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="transition hover:text-lime">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M21 7.917v4.034a9.948 9.948 0 0 1 -5 -1.951v4.5a6.5 6.5 0 1 1 -8 -6.326v4.326a2.5 2.5 0 1 0 4 2v-11.5h4.083a6.005 6.005 0 0 0 4.917 4.917z" /></svg>
      </a>
      <a href="https://x.com/Shopyos" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="transition hover:text-lime">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 4l11.733 16h4.267l-11.733 -16z" /><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772" /></svg>
      </a>
      <a href="https://www.threads.com/@shopyosecommerce" target="_blank" rel="noopener noreferrer" aria-label="Threads" class="transition hover:text-lime">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M19 7.5c-1.333 -3 -3.667 -4.5 -7 -4.5c-5 0 -8 2.5 -8 9s3.5 9 8 9s7 -3 7 -5s-1 -5 -7 -5c-2.5 0 -3 1.25 -3 2.5c0 1.5 1 2.5 2.5 2.5c2.5 0 3.5 -1.5 3.5 -5s-2 -4 -3 -4s-1.833 .333 -2.5 1" /></svg>
      </a>
      <a href="https://www.facebook.com/share/19Wd6Y1mEY/" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="transition hover:text-lime">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
      </a>
      <a href={"https://www.instagram.com/shopyosecommerce?utm_source=qr&igsi=MTkyZWxsamVpaXoweg=="} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="transition hover:text-lime">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
      </a>
    </div>
    <p>Kumasi, Ashanti Region, Ghana</p>
  </div>
</footer>
