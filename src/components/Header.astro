---
import iconDark from '../assets/icondark.png';
---
<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 w-[min(1240px,calc(100%-32px))] items-center justify-between gap-8 md:h-20 md:w-[min(1240px,calc(100%-40px))]">
    <a href="/" aria-label="Shopyos home" class="flex items-center">
      <img
        src={iconDark.src}
        width={iconDark.width}
        height={iconDark.height}
        alt="Shopyos"
        class="h-10 w-auto object-contain sm:h-12 md:h-16"
      />
    </a>
    <nav class="hidden items-center gap-7 text-sm font-bold text-navy md:flex">
      <a class="transition hover:text-lime" href="/about">About</a>
      <a class="transition hover:text-lime" href="/buyers">Buyers</a>
      <a class="transition hover:text-lime" href="/sellers">Sellers</a>
      <a class="transition hover:text-lime" href="/features">Features</a>
      <a class="transition hover:text-lime" href="/faq">FAQ</a>
    </nav>
    <a class="btn hidden px-5 py-3 text-sm md:inline-flex" href="/contact">Contact us</a>
    <details class="group relative md:hidden">
      <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-2xl bg-navy text-white shadow-sm transition hover:bg-[#1e3a8a]" aria-label="Open navigation menu">
        <span class="grid gap-1.5">
          <span class="block h-0.5 w-5 rounded-full bg-current transition group-open:translate-y-2 group-open:rotate-45"></span>
          <span class="block h-0.5 w-5 rounded-full bg-current transition group-open:opacity-0"></span>
          <span class="block h-0.5 w-5 rounded-full bg-current transition group-open:-translate-y-2 group-open:-rotate-45"></span>
        </span>
      </summary>
      <nav class="absolute right-0 top-14 w-[min(280px,calc(100vw-32px))] overflow-hidden rounded-3xl border border-slate-200 bg-white p-3 text-sm font-bold text-navy shadow-xl">
        <a class="block rounded-2xl px-4 py-3 transition hover:bg-[#eef7e4]" href="/about">About</a>
        <a class="block rounded-2xl px-4 py-3 transition hover:bg-[#eef7e4]" href="/buyers">Buyers</a>
        <a class="block rounded-2xl px-4 py-3 transition hover:bg-[#eef7e4]" href="/sellers">Sellers</a>
        <a class="block rounded-2xl px-4 py-3 transition hover:bg-[#eef7e4]" href="/features">Features</a>
        <a class="block rounded-2xl px-4 py-3 transition hover:bg-[#eef7e4]" href="/faq">FAQ</a>
        <a class="mt-2 block rounded-2xl bg-lime px-4 py-3 text-center text-white transition hover:brightness-95" href="/contact">Contact us</a>
      </nav>
    </details>
  </div>
</header>
