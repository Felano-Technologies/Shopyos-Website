---
import iconDark from '../assets/icondark.png';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/buyers', label: 'Buyers' },
  { href: '/sellers', label: 'Sellers' },
  { href: '/features', label: 'Features' },
  { href: '/faq', label: 'FAQ' },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---
<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="mx-auto flex h-16 w-[min(1240px,calc(100%-32px))] items-center justify-between gap-8 md:h-20 md:w-[min(1240px,calc(100%-40px))]">
    <a href="/" aria-label="Shopyos home" class="flex items-center">
      <img
        src={iconDark.src}
        width={iconDark.width}
        height={iconDark.height}
        alt="Shopyos"
        class="h-8 w-auto object-contain sm:h-9 md:h-11"
      />
    </a>
    <nav class="hidden items-center gap-7 text-sm font-bold text-navy md:flex">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'group relative inline-block py-1 transition hover:text-lime',
            { 'text-lime': isActive(link.href) },
          ]}
        >
          {link.label}
          <span
            class:list={[
              'pointer-events-none absolute -bottom-1 left-0 h-0.5 bg-lime transition-all duration-300',
              isActive(link.href) ? 'w-full' : 'w-0 group-hover:w-full',
            ]}
          />
        </a>
      ))}
    </nav>
    <a class="btn hidden rounded-full px-5 py-3 text-sm text-white md:inline-flex" href="/contact">Contact us</a>
    <details class="group relative md:hidden">
      <summary class="relative z-10 flex h-11 w-11 cursor-pointer list-none items-center justify-center text-navy transition hover:text-lime" aria-label="Open navigation menu">
        <span class="grid gap-1.5">
          <span class="block h-0.5 w-5 rounded-full bg-current transition group-open:translate-y-2 group-open:rotate-45"></span>
          <span class="block h-0.5 w-5 rounded-full bg-current transition group-open:opacity-0"></span>
          <span class="block h-0.5 w-5 rounded-full bg-current transition group-open:-translate-y-2 group-open:-rotate-45"></span>
        </span>
      </summary>
      <nav class="fixed inset-x-0 top-16 z-30 hidden h-[calc(100vh-4rem)] flex-col gap-1 overflow-y-auto bg-white p-6 text-lg font-bold text-navy group-open:flex group-open:animate-[mobile-nav-in_0.35s_ease-out]">
        {navLinks.map((link, i) => (
          <a
            href={link.href}
            style={`animation-delay:${i * 50}ms`}
            class:list={[
              'rounded-2xl px-4 py-4 transition hover:bg-[#eef7e4] group-open:animate-[mobile-link-in_0.4s_ease-out_backwards]',
              { 'bg-[#eef7e4] text-lime': isActive(link.href) },
            ]}
          >
            {link.label}
          </a>
        ))}
        <a
          class="mt-4 block rounded-full bg-lime px-4 py-4 text-center text-white transition hover:brightness-95 group-open:animate-[mobile-link-in_0.4s_ease-out_backwards]"
          style={`animation-delay:${navLinks.length * 50}ms`}
          href="/contact"
        >
          Contact us
        </a>
      </nav>
    </details>
  </div>
</header>
