---
import BaseLayout from '../layouts/BaseLayout.astro';
const faqs=[['When will Shopyos be available?','We are preparing for launch. Join the waitlist to receive early-access and availability updates.'],['What payment methods will be supported?','Shopyos is being designed for Ghana’s payment context, including mobile money and card-based payments where available.'],['How will delivery work?','The platform is designed to support local and inter-regional fulfilment, with order and delivery-status updates for supported deliveries.'],['Can I become a seller?','Yes. Sellers will be able to register a business, create a store profile, manage products and handle orders from one place.'],['How will returns or support work?','Support and order-history tools are planned to help customers get help with an order. Specific return policies will be shared at launch.'],['Will Shopyos be secure?','Trust features such as seller verification, reviews, payment safeguards and customer support are central to the platform design.']];
---
<BaseLayout title="Shopyos FAQ"><section class="page-hero"><div class="mx-auto w-[min(1120px,calc(100%-40px))]"><p class="eyebrow">Frequently asked questions</p><h1 class="mt-4 text-5xl font-extrabold tracking-tight text-navy md:text-7xl">Answers for shoppers, sellers and partners.</h1></div></section><section class="py-20"><div class="mx-auto max-w-3xl px-5">{faqs.map(([question,answer],index) => <details class="border-b border-slate-200 p-5" open={index === 0}><summary class="cursor-pointer font-bold text-navy">{question}</summary><p class="mt-3 text-muted">{answer}</p></details>)}</div></section></BaseLayout>
