---
import BaseLayout from '../layouts/BaseLayout.astro';
const faqs=[['Where can I use Shopyos?','Shopyos is available on the web at app.shopyosgh.com and as an app on Google Play and the App Store.'],['What payment methods are supported?','Available payment methods are shown during checkout and may vary by order.'],['How does delivery work?','Shopyos supports local fulfilment with order and delivery-status updates for supported deliveries.'],['Can I become a seller?','Yes. Sellers can register a business, create a store profile, manage products and handle orders on Shopyos.'],['How do returns or support work?','Support and order-history tools help customers get assistance with an order. See our return policy for details.'],['Is Shopyos secure?','Shopyos provides account and transaction safeguards, seller information and customer support tools.']];
---
<BaseLayout title="Shopyos FAQ"><section class="page-hero"><div class="mx-auto w-[min(1120px,calc(100%-40px))]"><p class="eyebrow">Frequently asked questions</p><h1 class="mt-4 text-5xl font-extrabold tracking-tight text-navy md:text-7xl">Answers for shoppers, sellers and partners.</h1></div></section><section class="py-20"><div class="mx-auto max-w-3xl px-5">{faqs.map(([question,answer],index) => <details class="border-b border-slate-200 p-5" open={index === 0}><summary class="cursor-pointer font-bold text-navy">{question}</summary><p class="mt-3 text-muted">{answer}</p></details>)}<div class="mt-10 flex flex-wrap items-center justify-center gap-4"><a class="btn" href="https://play.google.com/store/apps/details?id=com.eugeneanokye99.shopyos" target="_blank" rel="noopener noreferrer">Download Shopyos on Google Play</a><a class="font-bold text-navy underline" href="https://app.shopyosgh.com/" target="_blank" rel="noopener noreferrer">Open the web app</a></div></div></section></BaseLayout>
