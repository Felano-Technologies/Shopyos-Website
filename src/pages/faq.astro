---
import BaseLayout from '../layouts/BaseLayout.astro';
const faqs=[['Is Shopyos available yet?','Yes. Shopyos is currently available on Android through Google Play. The web application is currently under development, while the iOS application is coming soon.'],['What payment methods are supported?','Shopyos is designed for Ghana’s payment context, including mobile money and card-based payments where available.'],['How does delivery work?','The platform supports local and inter-regional fulfilment, with order and delivery-status updates for supported deliveries.'],['Can I become a seller?','Yes. Sellers can register a business, create a store profile, manage products and handle orders from the Shopyos Android app.'],['How do returns or support work?','Support and order-history tools help customers get help with an order. See our return policy for details.'],['Is Shopyos secure?','Trust features such as seller verification, reviews, payment safeguards and customer support are central to the platform.']];
---
<BaseLayout title="Shopyos FAQ"><section class="page-hero"><div class="mx-auto w-[min(1120px,calc(100%-40px))]"><p class="eyebrow">Frequently asked questions</p><h1 class="mt-4 text-5xl font-extrabold tracking-tight text-navy md:text-7xl">Answers for shoppers, sellers and partners.</h1></div></section><section class="py-20"><div class="mx-auto max-w-3xl px-5">{faqs.map(([question,answer],index) => <details class="border-b border-slate-200 p-5" open={index === 0}><summary class="cursor-pointer font-bold text-navy">{question}</summary><p class="mt-3 text-muted">{answer}</p></details>)}<div class="mt-10 text-center"><a class="btn" href="https://play.google.com/store/apps/details?id=com.eugeneanokye99.shopyos" target="_blank" rel="noopener noreferrer">Download Shopyos on Google Play</a></div></div></section></BaseLayout>
