---
import BaseLayout from '../layouts/BaseLayout.astro';
const features=[['Shopping experience','Browse products and stores, search by keyword, save favourites and discover deals.'],['Payments and payouts','Payment flows for buyers and clearer earnings and payout tools for sellers.'],['Order management','Keep track of orders, receipts, updates and customer conversations in one flow.'],['Logistics and fulfilment','Support delivery assignments, status changes, quotes and parcel movement.'],['Seller tools','Manage a store profile, listings, inventory, promotions and performance insights.'],['Support and community','Reviews, notifications, referrals and loyalty features help build trust.']];
---
<BaseLayout title="Shopyos Features"><section class="page-hero"><div class="mx-auto w-[min(1120px,calc(100%-40px))]"><p class="eyebrow">Platform features</p><h1 class="mt-4 max-w-4xl text-5xl font-extrabold tracking-tight text-navy md:text-7xl">All the tools local commerce needs, in one place.</h1><p class="mt-6 max-w-2xl text-lg text-muted">Shopyos focuses on product discovery, store management, order completion and delivery updates. Available now in the Shopyos Android application, with a <a class="font-bold text-navy underline" href="https://app.shopyosgh.com/" target="_blank" rel="noopener noreferrer">web experience</a> currently in development.</p></div></section><section class="py-20"><div class="mx-auto w-[min(1120px,calc(100%-40px))]"><div class="grid gap-5 md:grid-cols-3">{features.map(([title,copy]) => <article class="card"><p class="text-3xl text-lime-600">✦</p><h3 class="mt-5 text-xl">{title}</h3><p class="mt-3 text-muted">{copy}</p></article>)}</div></div></section></BaseLayout>
