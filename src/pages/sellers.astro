---
import BaseLayout from '../layouts/BaseLayout.astro';
const tools=[['Your digital storefront','Create a store profile, add products and manage your inventory in one place.'],['Promotions that help you grow','Plan promotions and flash sales to reach more people as features become available.'],['Orders and fulfilment','Manage customer orders and follow a clearer delivery workflow.']];
---
<BaseLayout title="Sell on Shopyos"><section class="page-hero"><div class="mx-auto grid w-[min(1120px,calc(100%-40px))] gap-10 md:grid-cols-2"><div><p class="eyebrow">For local businesses</p><h1 class="mt-4 text-5xl font-extrabold tracking-tight text-navy md:text-7xl">Build your store. Grow your reach.</h1><p class="mt-6 text-lg text-muted">Grow your local business with a digital storefront, product and inventory tools, promotions and support for order fulfilment.</p><div class="mt-8 flex flex-wrap items-center gap-4"><a class="btn" href="/contact">Become a seller</a><a class="btn-dark" href="/partners">Partner with us now</a></div></div><div class="card bg-navy text-white"><!-- FIGMA IMAGE: Export the seller dashboard or product-management screen to public/images/seller-dashboard.png, then replace this placeholder. --><div class="aspect-video rounded-xl bg-[linear-gradient(130deg,#203f99,#84cc16)] p-6"><p class="font-bold text-lime-200">SELLER DASHBOARD</p><div class="mt-7 grid grid-cols-3 gap-3"><div class="h-20 rounded bg-white/90"></div><div class="h-20 rounded bg-white/50"></div><div class="h-20 rounded bg-white/30"></div></div></div></div></div></section><section class="py-20"><div class="mx-auto w-[min(1120px,calc(100%-40px))]"><p class="eyebrow">Sell smarter</p><h2 class="mt-3 text-4xl font-extrabold text-navy">Tools built for your next stage of growth.</h2><div class="mt-10 grid gap-5 md:grid-cols-3">{tools.map(([title,copy]) => <article class="card"><h3>{title}</h3><p class="mt-3 text-muted">{copy}</p></article>)}</div><div class="mt-14 rounded-2xl border border-slate-200 bg-[#f8fafb] p-8 text-center md:p-10"><p class="eyebrow">Enterprise & High-Volume Trading</p><h3 class="mt-2 text-2xl font-extrabold text-navy md:text-3xl">Operating multi-branch retail, wholesale, or distribution?</h3><p class="mx-auto mt-3 max-w-xl text-muted">Discover customized commercial terms, catalog ingestion, and dedicated support for businesses scaling their trading services.</p><a class="btn mt-6" href="/partners">Partner with us now</a></div></div></section></BaseLayout>
