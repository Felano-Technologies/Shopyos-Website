---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Deliver with Shopyos"><section class="page-hero"><div class="mx-auto w-[min(1120px,calc(100%-40px))]"><p class="eyebrow">For delivery partners</p><h1 class="mt-4 text-5xl font-extrabold tracking-tight text-navy md:text-7xl">Help local commerce keep moving.</h1><p class="mt-6 max-w-2xl text-lg text-muted">Shopyos is being designed to support delivery assignments, status updates and fulfilment flows for local commerce partners.</p><a class="btn mt-8" href="/contact">Register your interest</a></div></section><section class="py-20"><div class="mx-auto grid w-[min(1120px,calc(100%-40px))] gap-5 md:grid-cols-3"><article class="card"><h3>Delivery assignments</h3><p class="mt-3 text-muted">Stay informed as an order moves through its delivery journey.</p></article><article class="card"><h3>Clear status flows</h3><p class="mt-3 text-muted">Support clear updates for buyers, sellers and delivery partners.</p></article><article class="card"><h3>Local impact</h3><p class="mt-3 text-muted">Help local stores reach more customers in their communities.</p></article></div></section></BaseLayout>
