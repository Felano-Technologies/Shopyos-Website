---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="About Shopyos"><section class="page-hero"><div class="mx-auto w-[min(1120px,calc(100%-40px))]"><p class="eyebrow">Local commerce, connected</p><h1 class="mt-4 max-w-4xl text-5xl font-extrabold tracking-tight text-navy md:text-7xl">Making everyday Ghanaian commerce easier.</h1><p class="mt-6 max-w-2xl text-lg text-muted">Shopyos connects shoppers, independent sellers and delivery partners in one useful marketplace experience.</p></div></section><section class="py-20"><div class="mx-auto grid w-[min(1120px,calc(100%-40px))] gap-10 md:grid-cols-2"><div><p class="eyebrow">Why Shopyos</p><h2 class="mt-3 text-4xl font-extrabold text-navy">One place for the people who make local commerce move.</h2></div><div class="card"><h3>Our mission</h3><p class="mt-3 text-muted">Help Ghanaian shoppers buy with confidence and local businesses grow online with practical tools for stores, inventory, orders and promotions.</p><h3 class="mt-7">Our vision</h3><p class="mt-3 text-muted">A more connected local economy where great products, trustworthy sellers and dependable delivery are easier to find.</p></div></div></section></BaseLayout>
