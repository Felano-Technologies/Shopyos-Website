---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Get Started with Shopyos"><section class="page-hero"><div class="mx-auto w-[min(1120px,calc(100%-40px))]"><p class="eyebrow">Get started</p><h1 class="mt-4 text-5xl font-extrabold tracking-tight text-navy md:text-7xl">Join the Shopyos journey.</h1><p class="mt-6 max-w-2xl text-lg text-muted">Shopyos is live now on Android. Whether you want to shop, sell, deliver or explore a partnership, let us know how you’d like to be involved.</p></div></section><section class="py-20"><div class="mx-auto grid w-[min(1120px,calc(100%-40px))] gap-12 md:grid-cols-2"><div><p class="eyebrow">Get in touch</p><h2 class="mt-3 text-4xl font-extrabold text-navy">Tell us what you’re interested in.</h2><p class="mt-4 text-muted">This form opens your email app so the site does not collect information directly.</p></div><form class="grid gap-4" action="mailto:hello@shopyos.com" method="post" enctype="text/plain"><label class="font-bold text-navy">Name<input class="mt-1 w-full rounded-lg border border-slate-300 p-3" name="name" required /></label><label class="font-bold text-navy">Email address<input class="mt-1 w-full rounded-lg border border-slate-300 p-3" name="email" type="email" required /></label><label class="font-bold text-navy">I’m interested in<select class="mt-1 w-full rounded-lg border border-slate-300 p-3" name="interest"><option>Shopping with Shopyos</option><option>Selling on Shopyos</option><option>Delivery partnership</option><option>Business or investment partnership</option></select></label><button class="btn mt-2" type="submit">Send message</button></form></div></section></BaseLayout>
