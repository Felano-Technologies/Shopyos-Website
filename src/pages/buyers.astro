---
import BaseLayout from '../layouts/BaseLayout.astro';
const features=[['Discover with ease','Search by product or category, browse stores and save items you love for later.'],['Talk and negotiate','Chat with sellers and use offers where available to find the right deal.'],['Checkout with confidence','Use familiar payment options and receive clear updates as your order progresses.']];
---
<BaseLayout title="Shop with Shopyos"><section class="page-hero"><div class="mx-auto w-[min(1120px,calc(100%-40px))]"><p class="eyebrow">For shoppers</p><h1 class="mt-4 text-5xl font-extrabold tracking-tight text-navy md:text-7xl">Discover more of what’s local.</h1><p class="mt-6 max-w-2xl text-lg text-muted">Browse products from local stores, talk to sellers, find deals and stay informed from checkout to delivery. Available now on Android, with a <a class="font-bold text-navy underline" href="https://app.shopyosgh.com/" target="_blank" rel="noopener noreferrer">web experience</a> currently in development.</p><a class="btn mt-8" href="https://play.google.com/store/apps/details?id=com.eugeneanokye99.shopyos" target="_blank" rel="noopener noreferrer">Download Shopyos and start shopping</a></div></section><section class="py-20"><div class="mx-auto w-[min(1120px,calc(100%-40px))]"><h2 class="text-4xl font-extrabold text-navy">A better way to shop.</h2><div class="mt-10 grid gap-5 md:grid-cols-3">{features.map(([title,copy]) => <article class="card"><div class="text-3xl text-lime-600">✦</div><h3 class="mt-5 text-xl">{title}</h3><p class="mt-3 text-muted">{copy}</p></article>)}</div></div></section></BaseLayout>
